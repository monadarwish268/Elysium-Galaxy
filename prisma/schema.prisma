generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatarUrl String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CheckIn {
  id          String   @id @default(cuid())
  userId      String
  mood        String
  energyLevel Int?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Planet {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  description      String
  themeColor       String?
  symbol           String?            @default("🪐")
  type             PlanetType?        @default(terrestrial)
  emotionType      PlanetEmotionType? @default(calm)
  color            String?            @default("#3b82f6")
  secondaryColor   String?            @default("#1e40af")
  atmosphereColor  String?            @default("#60a5fa")
  glowIntensity    Float?             @default(1.0)
  radius           Float?             @default(1.2)
  roughness        Float?             @default(0.5)
  metalness        Float?             @default(0.1)
  hasClouds        Boolean?           @default(false)
  cloudColor       String?
  hasRings         Boolean?           @default(false)
  ringColor        String?
  ringInnerRadius  Float?
  ringOuterRadius  Float?
  axialTilt        Float?             @default(0.0)
  rotationSpeed    Float?             @default(0.01)
  orbitAngleOffset Float?             @default(0.0)
  stats            Json?              @default("{\"emotion\": \"Calmness\", \"affirmation\": \"I am centered\", \"feelingState\": \"Peaceful\"}")
  activities       Activity[]
  bookings         Booking[]
  reflections      Reflection[]
}

model Activity {
  id          String       @id @default(cuid())
  planetId    String
  title       String
  description String
  type        String
  durationMin Int?
  createdAt   DateTime     @default(now())
  planet      Planet       @relation(fields: [planetId], references: [id], onDelete: Cascade)
  reflections Reflection[]
}

model Reflection {
  id         String    @id @default(cuid())
  userId     String
  planetId   String?
  content    String?
  tags       String?
  createdAt  DateTime  @default(now())
  activityId String?
  feelingNow String
  activity   Activity? @relation(fields: [activityId], references: [id])
  planet     Planet?   @relation(fields: [planetId], references: [id])

  @@index([userId])
}

model Psychologist {
  id          String    @id @default(cuid())
  name        String
  title       String
  hourlyRate  Float
  bio         String
  avatarUrl   String?
  specialties String[]
  bookings    Booking[]
}

model Booking {
  id             String       @id @default(cuid())
  userId         String
  psychologistId String
  planetId       String?
  scheduledAt    DateTime
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  planet         Planet?      @relation(fields: [planetId], references: [id])
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([psychologistId])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  planType  String
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum PlanetEmotionType {
  stress
  happiness
  sadness
  calm
  selfLove
  custom
}

enum PlanetType {
  terrestrial
  volcanic
  gas_giant
  ringed_giant
  ice_giant
  custom
}
