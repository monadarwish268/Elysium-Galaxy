
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  avatarUrl     String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  checkIns      CheckIn[]
  reflections   Reflection[]
  bookings      Booking[]
  subscriptions Subscription[]
}

model CheckIn {
  id          String   @id @default(cuid())
  userId      String
  mood        String   // e.g., "Anxious", "Calm", "Stress"
  energyLevel Int?     // Scale 1-10
  notes       String?  
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Planet {
  id          String       @id @default(cuid())
  slug        String       @unique // e.g., "calm-oasis", "stress"
  name        String
  description String       
  themeColor  String?

  activities  Activity[]
  reflections Reflection[]
  bookings    Booking[]
}

model Activity {
  id          String       @id @default(cuid())
  planetId    String
  title       String       // e.g., "Deep Breathing Exercise"
  description String       
  type        String       // e.g., "BREATHING", "JOURNALING"
  durationMin Int?

  planet      Planet       @relation(fields: [planetId], references: [id], onDelete: Cascade)
  reflections Reflection[]

  createdAt   DateTime     @default(now())
}

model Reflection {
  id          String    @id @default(cuid())
  userId      String
  planetId    String?
  activityId  String?
  feelingNow  String    // Answer to "How do you feel now?"
  content     String?   
  tags        String?

  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planet      Planet?   @relation(fields: [planetId], references: [id], onDelete: SetNull)
  activity    Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Psychologist {
  id          String    @id @default(cuid())
  name        String
  title       String
  specialties String?
  hourlyRate  Float
  bio         String    
  avatarUrl   String?

  bookings    Booking[]
}

model Booking {
  id             String       @id @default(cuid())
  userId         String
  psychologistId String
  planetId       String?
  scheduledAt    DateTime
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  planet         Planet?      @relation(fields: [planetId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([psychologistId])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  planType  String
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}